{
    "version": 4,
    "configurations": [
        {
            "name": "STM32F407-sentry",
            "compilerPath": "D:/SPR/msys64/mingw64/bin/arm-none-eabi-gcc.exe",
            "cStandard": "c99",
            "cppStandard": "c++14",
            "intelliSenseMode": "gcc-arm",
            "configurationProvider": "ms-vscode.cpptools",
            "defines": [
                "USE_HAL_DRIVER",
                "STM32F407xx",
                "ARM_MATH_CM4",
                "__FPU_USED=1U",
                "__FPU_PRESENT=1U",
                "ARM_MATH_MATRIX_CHECK",
                "ARM_MATH_ROUNDING"
            ],
            "includePath": [
                "${workspaceFolder}/sentry/Drivers/STM32F4xx_HAL_Driver/Inc",
                "${workspaceFolder}/sentry/Drivers/STM32F4xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/sentry/Drivers/CMSIS/Device/ST/STM32F4xx/Include",
                "${workspaceFolder}/sentry/Drivers/CMSIS/Include",
                "${workspaceFolder}/sentry/Middlewares/Third_Party/FreeRTOS/Source/include",
                "${workspaceFolder}/sentry/Middlewares/Third_Party/FreeRTOS/Source/CMSIS_RTOS",
                "${workspaceFolder}/sentry/Middlewares/Third_Party/FreeRTOS/Source/portable/RVDS/ARM_CM4F",
                "${workspaceFolder}/sentry/Middlewares/ST/STM32_USB_Device_Library/Core/Inc",
                "${workspaceFolder}/sentry/Middlewares/ST/STM32_USB_Device_Library/Class/CDC/Inc",
                "${workspaceFolder}/sentry/Inc",
                "${workspaceFolder}/sentry/User/Inc",
                "${workspaceFolder}/sentry/Hardware/Inc",
                "${workspaceFolder}/sentry/boards",
                "${workspaceFolder}/sentry/Task",
                "${workspaceFolder}/sentry/application",
                "${workspaceFolder}/sentry/application/protocol",
                "${workspaceFolder}/sentry/components/algorithm",
                "${workspaceFolder}/sentry/components/algorithm/Include",
                "${workspaceFolder}/sentry/components/controller",
                "${workspaceFolder}/sentry/components/devices",
                "${workspaceFolder}/sentry/components/support",
                "${workspaceFolder}/sentry/MDK-ARM"
            ],
            "browse": {
                "path": ["${workspaceFolder}/sentry"],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
