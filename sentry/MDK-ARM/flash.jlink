// J-Link Commander 脚本：把 standard/sentry.hex 烧进 STM32F407
// 由 VS Code 任务 "J-Link: 烧录 HEX" 调用（工作目录 = MDK-ARM）
// 手动用：JLink.exe -NoGui 1 -ExitOnError 1 -CommanderScript flash.jlink

si SWD                  // 接口：SWD
speed 4000              // 4 MHz（线长的话降到 1000）
device STM32F407IG
connect

r                       // 复位并停下 CPU
h                       // 停住
loadfile standard/sentry.hex

r                       // 再复位一次，让新程序从头跑
g                       // 运行
qc                      // 退出
